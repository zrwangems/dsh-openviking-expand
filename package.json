{
  "name": "dsh-openviking-expand",
  "version": "0.3.0",
  "description": "OpenViking bundle for DeepSeek Harness: the Studio console in the left sidebar and a viking:// tree in the right sidebar",
  "license": "AGPL-3.0-only",
  "author": "zrwangems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zrwangems/dsh-openviking-expand.git"
  },
  "homepage": "https://github.com/zrwangems/dsh-openviking-expand#readme",
  "bugs": {
    "url": "https://github.com/zrwangems/dsh-openviking-expand/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "openviking",
    "console",
    "sidebar",
    "better-sidebar",
    "plugin",
    "bundle"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "type": "module",
  "main": "host/index.mjs",
  "icon": "./icons/openviking-expand.png",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs && node --check lib/client.js",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run check && npm test && node scripts/smoke-client.mjs"
  },
  "exports": {
    ".": "./host/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icons/openviking-expand.png",
    "./console": "./host/components/console/index.mjs",
    "./sidebar": "./host/components/sidebar/index.mjs",
    "./console/locale/*.json": "./locale/console/*.json",
    "./console/icon": "./icons/console.png",
    "./sidebar/locale/*.json": "./locale/sidebar/*.json",
    "./sidebar/icon": "./icons/sidebar.png"
  },
  "files": [
    "host/",
    "client/",
    "lib/",
    "scripts/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "detail.md",
    "LICENSE",
    "icons/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
